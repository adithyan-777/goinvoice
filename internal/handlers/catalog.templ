templ ProductsSection(rows []sqlc.Product, errMsg string) {
	<div class="page-head">
		<div class="page-head__copy">
			<h1 class="page-head__title">Products</h1>
			<p class="page-head__subtitle">Catalog of billable items</p>
		</div>
		<div class="page-head__actions">
			<a class="btn btn--primary" href="/products/new" data-on:click__prevent={ dsCatalogNew("products", "Product") }>New</a>
		</div>
	</div>
	if errMsg != "" {
		<div class="alert alert--error" role="alert">{ errMsg }</div>
	}
	if len(rows) == 0 {
		<div class="empty-stage">
			<div class="empty-stage__icon"><i class="bx bx-package"></i></div>
			<div class="empty-stage__title">No products yet</div>
		</div>
	} else {
		<div class="card card--table">
			<div class="card__body">
				<div class="data-table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Ref</th>
								<th>Name</th>
								<th class="num">Price</th>
								<th>Unit</th>
								<th>Description</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, p := range rows {
								<tr>
									<td>{ p.Ref }</td>
									<td>{ p.Name }</td>
									<td class="num">{ p.Price } { p.Currency }</td>
									<td>{ nsStr(p.Unit) }</td>
									<td>{ nsStr(p.Description) }</td>
									<td class="table-actions">
										<button type="button" class="btn-icon" title="Edit" data-on:click__prevent={ dsEditGet("products", p.ID) }><i class="bx bx-edit admin-icon admin-icon--18"></i></button>
										<button type="button" class="btn-icon btn-icon--danger" title="Delete" data-on:click={ dsDelete("products", p.ID, p.Ref) }><i class="bx bx-trash admin-icon admin-icon--18"></i></button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

templ ProductsPage(rows []sqlc.Product, errMsg string) {
	@Layout("products · Ittisal Invoice", "products") {
		@ProductsSection(rows, errMsg)
	}
}

templ ProductForm(p sqlc.Product, errMsg string) {
	if errMsg != "" {
		<div class="alert alert--error" role="alert">{ errMsg }</div>
	}
	<form method="post" action={ catalogAction("products", p.ID) } class="form-grid" data-on:submit__prevent={ dsCatalogSubmit("products", p.ID) }>
		<div class="form-field"><label class="form-label">Ref</label><input class="form-input" type="text" name="ref" value={ p.Ref } required/></div>
		<div class="form-field"><label class="form-label">Name</label><input class="form-input" type="text" name="name" value={ p.Name } required/></div>
		<div class="form-field"><label class="form-label">Key</label><input class="form-input" type="text" name="key" value={ nsStr(p.Key) } placeholder="goods|services"/></div>
		<div class="form-field"><label class="form-label">Price</label><input class="form-input" type="text" name="price" value={ p.Price } placeholder="100.00"/></div>
		<div class="form-field"><label class="form-label">List price</label><input class="form-input" type="text" name="list" value={ nsStr(p.List) }/></div>
		<div class="form-field"><label class="form-label">Discount</label><input class="form-input" type="text" name="discount" value={ nsStr(p.Discount) }/></div>
		<div class="form-field"><label class="form-label">Per quantity</label><input class="form-input" type="text" name="per" value={ nsStr(p.Per) } placeholder="1"/></div>
		<div class="form-field"><label class="form-label">Currency</label><input class="form-input" type="text" name="currency" value={ p.Currency } placeholder="EUR"/></div>
		<div class="form-field"><label class="form-label">Unit</label><input class="form-input" type="text" name="unit" value={ nsStr(p.Unit) } placeholder="hour"/></div>
		<div class="form-field"><label class="form-label">Origin</label><input class="form-input" type="text" name="origin" value={ nsStr(p.Origin) } placeholder="ES"/></div>
		<div class="form-field form-field--full"><label class="form-label">Description</label><input class="form-input" type="text" name="description" value={ nsStr(p.Description) }/></div>
		<div class="form-actions"><button type="submit" class="btn btn--primary">{ catalogSubmitLabel(p.ID, "product") }</button></div>
	</form>
}

templ ProductEditPage(p sqlc.Product, errMsg string) {
	@Layout("edit product · Ittisal Invoice", "products") {
		<div class="page-head">
			<div class="page-head__copy">
				<h1 class="page-head__title">Edit product</h1>
			</div>
		</div>
		<div class="card">
			<div class="card__body">
				@ProductForm(p, errMsg)
			</div>
		</div>
	}
}

templ ProductNewPage(p sqlc.Product) {
	@Layout("new product · Ittisal Invoice", "products") {
		<div class="page-head">
			<div class="page-head__copy">
				<h1 class="page-head__title">New product</h1>
			</div>
		</div>
		<div class="card">
			<div class="card__body">
				@ProductForm(p, "")
			</div>
		</div>
	}
}

// CustomerCreateForm renders the compact "new customer" form used from the
// document modal. On success the server re-renders the document form with
// the new customer selected.
templ CustomerCreateForm(f CustomerFormData) {
	if f.Err != "" {
		<div class="alert alert--error" role="alert">{ f.Err }</div>
	}
	<form method="post" action="/customers" class="form-grid" data-on:submit__prevent="@post('/customers', {contentType: 'form'})">
		<input type="hidden" name="modal" value="1"/>
		<input type="hidden" name="for" value={ f.For }/>
		<div class="form-field form-field--full">
			<label class="form-label" for="nc-name">Name</label>
			<input class="form-input" id="nc-name" type="text" name="name" value={ f.Name } required/>
		</div>
		<div class="form-field">
			<label class="form-label" for="nc-country">Tax country</label>
			<input class="form-input" id="nc-country" type="text" name="tax_country" value={ f.TaxCountry } placeholder="ES"/>
		</div>
		<div class="form-field">
			<label class="form-label" for="nc-code">Tax ID</label>
			<input class="form-input" id="nc-code" type="text" name="tax_code" value={ f.TaxCode } placeholder="A12345674"/>
		</div>
		<div class="form-field form-field--full">
			<label class="form-label" for="nc-email">Email</label>
			<input class="form-input" id="nc-email" type="email" name="email" value={ f.Email }/>
		</div>
		<div class="form-actions">
			<button type="submit" class="btn btn--primary">Create customer</button>
		</div>
	</form>
}

// SupplierCreateForm renders the compact "new supplier" form used from the
// document modal. On success the server re-renders the document form with
// the new supplier selected.
templ SupplierCreateForm(f CustomerFormData) {
	if f.Err != "" {
		<div class="alert alert--error" role="alert">{ f.Err }</div>
	}
	<form method="post" action="/suppliers" class="form-grid" data-on:submit__prevent="@post('/suppliers', {contentType: 'form'})">
		<input type="hidden" name="modal" value="1"/>
		<input type="hidden" name="for" value={ f.For }/>
		<div class="form-field form-field--full">
			<label class="form-label" for="ns-name">Name</label>
			<input class="form-input" id="ns-name" type="text" name="name" value={ f.Name } required/>
		</div>
		<div class="form-field">
			<label class="form-label" for="ns-country">Tax country</label>
			<input class="form-input" id="ns-country" type="text" name="tax_country" value={ f.TaxCountry } placeholder="ES"/>
		</div>
		<div class="form-field">
			<label class="form-label" for="ns-code">Tax ID</label>
			<input class="form-input" id="ns-code" type="text" name="tax_code" value={ f.TaxCode } placeholder="B98602642"/>
		</div>
		<div class="form-field form-field--full">
			<label class="form-label" for="ns-email">Email</label>
			<input class="form-input" id="ns-email" type="email" name="email" value={ f.Email }/>
		</div>
		<div class="form-actions">
			<button type="submit" class="btn btn--primary">Create supplier</button>
		</div>
	</form>
}
