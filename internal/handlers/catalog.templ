	} else {
		<div class="card card--table">
			<div class="card__body">
				<div class="data-table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Tax ID</th>
								<th>Email</th>
								<th>Locality</th>
								<th>Country</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, s := range rows {
								<tr>
									<td>{ s.Name }</td>
									<td>{ nsStr(s.TaxCountry) } { nsStr(s.TaxCode) }</td>
									<td>{ nsStr(s.Email) }</td>
									<td>{ nsStr(s.Locality) }</td>
									<td>{ nsStr(s.Country) }</td>
									<td class="table-actions">
										<button type="button" class="btn-icon" title="Edit" data-on:click__prevent={ dsEditGet("suppliers", s.ID) }><i class="bx bx-edit admin-icon admin-icon--18"></i></button>
										<button type="button" class="btn-icon btn-icon--danger" title="Delete" data-on:click={ dsDelete("suppliers", s.ID, s.Name) }><i class="bx bx-trash admin-icon admin-icon--18"></i></button>
									</td>
								</tr>
							}
						</tbody>
