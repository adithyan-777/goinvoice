				<div class="form-field"><label class="form-label" for="s-locality">Locality</label><input class="form-input" id="s-locality" type="text" name="locality"/></div>
				<div class="form-field"><label class="form-label" for="s-postcode">Post code</label><input class="form-input" id="s-postcode" type="text" name="post_code"/></div>
				<div class="form-field"><label class="form-label" for="s-country">Country</label><input class="form-input" id="s-country" type="text" name="country" placeholder="ES"/></div>
