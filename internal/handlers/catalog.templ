package handlers

import (
	"github.com/neo/goinvoice/internal/db/sqlc"
)

// Datastar expression attributes are held as Go constants because templ
// parses `{}` in literal attribute values as Go expressions. Dynamic URLs
// are built with tiny helpers below.

const (
	dsNavInvoices   = "$nav = 'invoices'; @get('/partials/invoices')"
	dsNavOrders     = "$nav = 'orders'; @get('/partials/orders')"
	dsNavDeliveries = "$nav = 'deliveries'; @get('/partials/deliveries')"
	dsNavPayments   = "$nav = 'payments'; @get('/partials/payments')"
	dsNavStatuses   = "$nav = 'statuses'; @get('/partials/statuses')"
	dsNavCustomers = "$nav = 'customers'; @get('/partials/customers')"
	dsNavSuppliers = "$nav = 'suppliers'; @get('/partials/suppliers')"
	dsNavProducts  = "$nav = 'products'; @get('/partials/products')"
)

// dsNavActive marks the sidebar link of the current section.
func dsNavActive(section string) string {
	return "{'is-active': $nav === '" + section + "'}"
}

// dsEditGet returns the expression that loads an edit form into the modal.
func dsEditGet(kind, id string) string {
	return "$modalOpen = true; @get('/partials/" + kind + "/" + id + "/form')"
}

// dsDocSubmit returns the expression that submits a document form to the
// given action. The modal stays open until the server confirms success with
// a `modalOpen: false` signal patch; failures re-render the form in place.
func dsDocSubmit(action string) string {
	return "@post('" + action + "', {contentType: 'form'})"
}

// dsDocNew opens the modal and loads the New form fragment for a kind.
func dsDocNew(route, one string) string {
	return "$modalTitle = 'New " + one + "'; $modalOpen = true; @get('/partials/" + route + "/new')"
}

// dsDocEdit opens the modal and loads the Edit form fragment for a document.
func dsDocEdit(route, id, one string) string {
	return "$modalTitle = 'Edit " + one + "'; $modalOpen = true; @get('/partials/" + route + "/" + id + "/edit')"
}

// dsCatalogNew opens the modal and loads the New catalog form.
func dsCatalogNew(kind, one string) string {
	return "$modalTitle = 'New " + one + "'; $modalOpen = true; @get('/partials/" + kind + "/new')"
}

// catalogAction returns the POST target for a catalog form.
func catalogAction(kind, id string) string {
	if id == "" {
		return "/" + kind
	}
	return "/" + kind + "/" + id
}

// dsCatalogSubmit returns the Datastar expression that submits a catalog form.
func dsCatalogSubmit(kind, id string) string {
	return "@post('" + catalogAction(kind, id) + "', {contentType: 'form'})"
}

// catalogSubmitLabel returns the form button label.
func catalogSubmitLabel(id, one string) string {
	if id == "" {
		return "Create " + one
	}
	return "Save"
}

// dsNewCustomer opens the "new customer" modal from a document form.
func dsNewCustomer(route string) string {
	return "$modalTitle = 'New Customer'; @get('/partials/customers/new?for=" + route + "')"
}

// dsNewSupplier opens the "new supplier" modal from a document form.
func dsNewSupplier(route string) string {
	return "$modalTitle = 'New Supplier'; @get('/partials/suppliers/new?for=" + route + "')"
}

// dsDelete returns the expression that confirms and deletes a row, then
// refreshes the section.
func dsDelete(kind, id, label string) string {
	return "confirm('Delete " + label + "?') && @post('/" + kind + "/" + id + "/delete')"
}

templ CustomersSection(rows []sqlc.Customer, errMsg string) {
	<div class="page-head">
		<div class="page-head__copy">
			<h1 class="page-head__title">Customers</h1>
			<p class="page-head__subtitle">Bill-to parties reused across invoices</p>
		</div>
		<div class="page-head__actions">
			<a class="btn btn--primary" href="/customers/new" data-on:click__prevent={ dsCatalogNew("customers", "Customer") }>New</a>
		</div>
	</div>
	if errMsg != "" {
		<div class="alert alert--error" role="alert">{ errMsg }</div>
	}
	if len(rows) == 0 {
		<div class="empty-stage">
			<div class="empty-stage__icon"><i class="bx bx-user"></i></div>
			<div class="empty-stage__title">No customers yet</div>
		</div>
	} else {
		<div class="card card--table">
			<div class="card__body">
				<div class="data-table-wrap">
					<table class="data-table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Tax ID</th>
								<th>Email</th>
								<th>Locality</th>
								<th>Country</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, c := range rows {
								<tr>
									<td>{ c.Name }</td>
									<td>{ nsStr(c.TaxCountry) } { nsStr(c.TaxCode) }</td>
									<td>{ nsStr(c.Email) }</td>
									<td>{ nsStr(c.Locality) }</td>
									<td>{ nsStr(c.Country) }</td>
									<td class="table-actions">
										<button type="button" class="btn-icon" title="Edit" data-on:click__prevent={ dsEditGet("customers", c.ID) }><i class="bx bx-edit admin-icon admin-icon--18"></i></button>
										<button type="button" class="btn-icon btn-icon--danger" title="Delete" data-on:click={ dsDelete("customers", c.ID, c.Name) }><i class="bx bx-trash admin-icon admin-icon--18"></i></button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

templ CustomersPage(rows []sqlc.Customer, errMsg string) {
	@Layout("customers · Ittisal Invoice", "customers") {
		@CustomersSection(rows, errMsg)
	}
}

templ CustomerForm(f PartyFormData) {
	if f.Err != "" {
		<div class="alert alert--error" role="alert">{ f.Err }</div>
	}
	<form method="post" action={ catalogAction("customers", f.ID) } class="form-grid" data-on:submit__prevent={ dsCatalogSubmit("customers", f.ID) }>
		<div class="form-field"><label class="form-label">Name</label><input class="form-input" type="text" name="name" value={ f.Name } required/></div>
		<div class="form-field"><label class="form-label">Label</label><input class="form-input" type="text" name="label" value={ f.Label } placeholder="Customer"/></div>
		<div class="form-field"><label class="form-label">Alias</label><input class="form-input" type="text" name="alias" value={ f.Alias }/></div>
		<div class="form-field"><label class="form-label">Tax country</label><input class="form-input" type="text" name="tax_country" value={ f.TaxCountry } placeholder="ES"/></div>
		<div class="form-field"><label class="form-label">Tax code</label><input class="form-input" type="text" name="tax_code" value={ f.TaxCode }/></div>
		<div class="form-field"><label class="form-label">Tax scheme</label><input class="form-input" type="text" name="tax_scheme" value={ f.TaxScheme } placeholder="VAT"/></div>
		<div class="form-field"><label class="form-label">Tax type</label><input class="form-input" type="text" name="tax_type" value={ f.TaxType }/></div>
		<div class="form-field"><label class="form-label">Email</label><input class="form-input" type="email" name="email" value={ f.Email }/></div>
		<div class="form-field"><label class="form-label">Phone</label><input class="form-input" type="tel" name="phone" value={ f.Phone }/></div>
		<div class="form-field"><label class="form-label">Website</label><input class="form-input" type="url" name="website" value={ f.Website }/></div>
		<div class="form-field"><label class="form-label">Address</label><input class="form-input" type="text" name="address_line" value={ f.Address }/></div>
		<div class="form-field"><label class="form-label">Locality</label><input class="form-input" type="text" name="locality" value={ f.Locality }/></div>
		<div class="form-field"><label class="form-label">Post code</label><input class="form-input" type="text" name="post_code" value={ f.PostCode }/></div>
		<div class="form-field"><label class="form-label">Country</label><input class="form-input" type="text" name="country" value={ f.Country } placeholder="ES"/></div>
		<div class="form-actions"><button type="submit" class="btn btn--primary">{ catalogSubmitLabel(f.ID, "customer") }</button></div>
	</form>
}

templ CustomerEditPage(f PartyFormData) {
	@Layout("edit customer · Ittisal Invoice", "customers") {
		<div class="page-head">
			<div class="page-head__copy">
				<h1 class="page-head__title">Edit customer</h1>
			</div>
		</div>
		<div class="card">
			<div class="card__body">
				@CustomerForm(f)
			</div>
		</div>
	}
}

templ CustomerNewPage(f PartyFormData) {
	@Layout("new customer · Ittisal Invoice", "customers") {
		<div class="page-head">
			<div class="page-head__copy">
				<h1 class="page-head__title">New customer</h1>
			</div>
		</div>
		<div class="card">
			<div class="card__body">
				@CustomerForm(f)
			</div>
		</div>
	}
}

